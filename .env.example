DB_URI=mongodb://localhost:27017/your-database
PORT=8100
JWT_SECRET=your_secret_key
SLACK_ERROR_WEBHOOK=

# --- Cuestionario PHB (Assessment) ---
# Webhook del CRM que se dispara UNA vez al completar el 100%
# (el valor real vive en Vercel, no aqui)
GHL_ASSESSMENT_WEBHOOK=https://services.leadconnectorhq.com/hooks/<LOCATION_ID>/webhook-trigger/<TRIGGER_ID>
# Dominio publico donde vive /r/:publicId (se usa para construir reporte_url)
PUBLIC_REPORT_BASE_URL=https://app-powerhouse-backapp.vercel.app
# CTA del reporte
PUBLIC_BOOKING_URL=https://powerhousebiotech.com/

# --- Estudios IA ---
# Modelo usado para generar el estudio del cuestionario
STUDY_AI_MODEL=claude-sonnet-4-6
# Webhook de GHL que entrega el estudio por WhatsApp (si falta usa GHL_ASSESSMENT_WEBHOOK)
GHL_STUDY_WEBHOOK=
# Token para que la cola pueda auto-invocarse sin sesion
QUEUE_TOKEN=
